table SupplierSpendMonth
	lineageTag: 4800208c-a15a-4203-887f-673270ad68ee

	column month_start
		dataType: dateTime
		isHidden
		formatString: Long Date
		lineageTag: 64258103-58f4-4ce0-ad11-00c30d3b18dd
		summarizeBy: none
