	partition SupplierSpendMonth = m
		mode: import
		source =
				let
				    Raw = #"DevTable"("MARTS", "SUPPLIER_MONTHLY"),
				    Selected = Table.SelectColumns(Raw, {"MONTH_START", "SUPPLIER_KEY", "SUPPLIER_SPEND"}),
				    Lower = Table.TransformColumnNames(Selected, Text.Lower)
				in
				    Lower

