	column observed_through
		dataType: dateTime
		formatString: Long Date
		lineageTag: 409b7d73-23ad-4b81-a7d4-d82f0b0319e4
		summarizeBy: none
		sourceColumn: observed_through

		annotation UnderlyingDateTimeDataType = Date

	column horizon
		dataType: double
		lineageTag: c3ce5e62-652b-45a8-bf29-f6e630ef1c6f
		summarizeBy: sum
		sourceColumn: horizon

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column series_attempted
