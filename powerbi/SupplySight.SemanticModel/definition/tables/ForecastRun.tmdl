	column records_produced
		dataType: double
		isHidden
		lineageTag: b5f97c88-b2f5-4a82-a10d-f08d475f3ef9
		summarizeBy: sum
		sourceColumn: records_produced

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition ForecastRun = m
		mode: import
		source =
				let
				    RunId = #"ScenarioRunId",
				    Raw = #"DevTable"("FORECASTING", "RUN_METADATA"),
				    Filtered = Table.SelectRows(Raw, each [RUN_ID] = RunId),
				    Selected = Table.SelectColumns(Filtered, {"RUN_ID", "STATUS", "OBSERVED_THROUGH", "HORIZON", "SERIES_ATTEMPTED", "SERIES_SUCCEEDED", "SERIES_FALLBACK", "SERIES_FAILED", "RECORDS_PRODUCED"}),
				    Result = Table.TransformColumnNames(Selected, Text.Lower)
				in
				    Result

