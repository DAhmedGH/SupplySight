		lineageTag: 3de8cac4-597b-4fc2-80b9-4f678678ebe2
		summarizeBy: none
		sourceColumn: forecast_date

		annotation UnderlyingDateTimeDataType = Date

	column product_id
		dataType: string
		isHidden
		lineageTag: fb6564f0-f7ac-4e65-a723-531fce9bf59b
		summarizeBy: none
		sourceColumn: product_id

	column warehouse_key
		dataType: string
		isHidden
		lineageTag: f28d7d8a-0155-40fc-8c4f-b9beddcd7d5c
		summarizeBy: none
		sourceColumn: warehouse_key

	column predicted_demand
		dataType: double
		isHidden
		lineageTag: d14c2dfc-a7ac-40ad-9365-91d76a76d6f0
		summarizeBy: none
		sourceColumn: predicted_demand

	column lower_bound
		dataType: double
		isHidden
		lineageTag: 53592245-f640-4f75-b25b-197d127463d3
