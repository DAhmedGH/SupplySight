	column residual_sample_count
		dataType: double
		lineageTag: 48b45b3f-68db-4333-83a3-d74080d3ab70
		summarizeBy: sum
		sourceColumn: residual_sample_count

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition ForecastMonth = m
		mode: import
		source =
				let
				    RunId = #"ScenarioRunId",
				    Raw = #"DevTable"("FORECASTING", "CURRENT_FORECASTS"),
				    Filtered = Table.SelectRows(Raw, each [RUN_ID] = RunId),
				    Selected = Table.SelectColumns(Filtered, {"RUN_ID", "FORECAST_DATE", "PRODUCT_ID", "WAREHOUSE_KEY", "PREDICTED_DEMAND", "LOWER_BOUND", "UPPER_BOUND", "MODEL_NAME", "FALLBACK_REASON", "UNCERTAINTY_METHOD", "RESIDUAL_SAMPLE_COUNT"}),
				    Result = Table.TransformColumnNames(Selected, Text.Lower)
				in
				    Result

