# Copy to airflow/.env and replace the placeholders before starting Compose.
AIRFLOW_UID=50000
AIRFLOW_DB_USER=airflow
# Use URL-unreserved characters only (A-Z, a-z, 0-9, _, -, ., ~), since the
# value is embedded in the SQLAlchemy connection URL. Generate with: openssl rand -hex 32
AIRFLOW_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
AIRFLOW_FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
AIRFLOW_WEBSERVER_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
AIRFLOW_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD
AIRFLOW_WEBSERVER_PORT=8080

# Snowflake access is passed only to Airflow task services.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=SUPPLYSIGHT_DEV_SERVICE
SNOWFLAKE_DATABASE=SUPPLY_CHAIN_DEV
SNOWFLAKE_WAREHOUSE=SUPPLY_CHAIN_DEV_WH
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_PRIVATE_KEY_HOST_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
